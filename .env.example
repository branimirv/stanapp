# Copy to .env and fill in your Supabase project values.
# Dashboard: https://supabase.com/dashboard/project/_/settings/api

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Sign-In (native) — public client IDs only; Client Secret stays in Supabase Dashboard.
# 1) Google Cloud Console → create Web + iOS + Android OAuth clients
# 2) Supabase → Authentication → Providers → Google: enable, paste Web Client ID+Secret,
#    add iOS/Android Client IDs (comma-separated after Web), enable Skip nonce check
# 3) Set iosUrlScheme in app.json to the iOS client's REVERSED_CLIENT_ID
#    (com.googleusercontent.apps.<prefix>) then rebuild: expo run:ios / expo run:android
# Docs: https://supabase.com/docs/guides/auth/social-login/auth-google?platform=react-native

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
