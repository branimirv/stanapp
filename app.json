{
  "expo": {
    "name": "StanApp",
    "slug": "stanapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stanapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stanapp.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to photograph expense receipts",
        "NSPhotoLibraryUsageDescription": "Used to select property and receipt photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.stanapp.mobile",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "./plugins/withLocalNotificationsOnly.js",
      "expo-localization",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StanApp to access your photos.",
          "cameraPermission": "Allow StanApp to use the camera."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F2",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0B0D"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.617435136110-gprog41jt73f6k3ms2v16ll8iu5t0a1m"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "project": "react-native",
          "organization": "branimir-valentin"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f672e1e0-515a-471c-8956-984f1af72283"
      },
      "router": {}
    },
    "owner": "branimirv"
  }
}
